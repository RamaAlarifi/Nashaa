# Copy this file to backend/.env and fill in real values.
# Never commit backend/.env.

# ---------- Database ----------
# Matches docker-compose.yml defaults. Override for production.
DATABASE_URL=postgresql+psycopg://nashaa:nashaa_dev_password@localhost:5432/nashaa

# ---------- Security ----------
# Generate a long random string for signing/encrypting session tokens.
SECRET_KEY=change-me-to-a-long-random-string
# Seconds a session stays valid (default 14 days).
SESSION_EXPIRE_SECONDS=1209600
# Seconds a password-reset token stays valid (default 30 minutes).
RESET_EXPIRE_SECONDS=1800

# ---------- CORS ----------
# Comma-separated list of allowed origins for the browser app.
FRONTEND_ORIGIN=http://localhost:3000

# ---------- AI provider ----------
# Which assessment provider to use: "gemini" or "mock".
AI_PROVIDER=gemini
# Google Gemini API key (get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
# Model name to call.
GEMINI_MODEL=gemini-1.5-flash
# Seconds to wait for an AI response before treating it as a delay/failure.
AI_TIMEOUT_SECONDS=60

# ---------- App ----------
APP_NAME=Nashaa
ENVIRONMENT=development
