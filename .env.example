# Nashaa environment example (Docker + local).
# Copy this file to .env and fill in real values. Never commit .env.
# (Nashaa_Guide.md §25 — environment settings & secret handling.)

# ---- App ----
APP_NAME=Nashaa
# development | testing | production (read by the backend)
ENVIRONMENT=development

# ---- PostgreSQL ----
# Used by the `database` container AND by the backend's DATABASE_URL.
# Keep these consistent with DATABASE_URL below.
POSTGRES_USER=nashaa
POSTGRES_PASSWORD=nashaa_dev_password
POSTGRES_DB=nashaa

# Backend database URL. In Docker the host is the `database` service name.
# For host-run development use localhost:5432.
DATABASE_URL=postgresql+psycopg://nashaa:nashaa_dev_password@database:5432/nashaa

# ---- Security ----
# Generate a long random value for signing session tokens.
SECRET_KEY=replace_with_a_long_random_value
SESSION_EXPIRE_SECONDS=1209600   # 14 days
RESET_EXPIRE_SECONDS=1800         # 30 minutes

# ---- CORS / URLs ----
# Comma-separated allowed origins for the browser app (backend CORS).
FRONTEND_ORIGIN=http://localhost:3000
# Server-side URL the Next.js server uses to proxy /api/* to FastAPI.
BACKEND_URL=http://localhost:8000

# ---- AI provider ----
# "mock" returns clearly-labeled simulated assessments (no API key needed).
# "gemini" calls Google Gemini (set GEMINI_API_KEY).
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=
AI_TIMEOUT_SECONDS=60

# ---- Demo data ----
# Set to true to load fictional demo data when the backend starts. Kept off by
# default (guide §25). Never enable in production.
LOAD_DEMO_DATA=false

# Password recovery: SMTP required in production. Local demo link is opt-in.
EXPOSE_RESET_TOKENS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
RESET_URL=http://localhost:3000/reset-password
